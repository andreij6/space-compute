{
  "name": "space-compute-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bindings": "for c in platform payments aaa treasury; do icp-bindgen --did-file ../../crates/$c/$c.did --out-dir src/bindings --force >/dev/null; done",
    "dev": "vite",
    "build": "npm run -s typecheck && vite build",
    "typecheck": "npm run -s bindings && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@icp-sdk/auth": "^10.0.1",
    "@icp-sdk/core": "^6.1.0",
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@icp-sdk/bindgen": "^0.4.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
