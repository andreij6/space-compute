type AaaCounters = record {
  reviews : nat64;
  discoveries : nat64;
  confirmed : nat64;
  classifications : nat64;
};
type AaaPublic = record {
  xp : nat64;
  status : AaaStatus;
  name : text;
  badges : nat64;
  tier : nat8;
  next_tier_xp : nat64;
  created_at : nat64;
  reputation_bp : nat32;
  counters : AaaCounters;
  avatar_seed : nat64;
};
type AaaRecord = record {
  v : nat8;
  status : AaaStatus;
  owner : principal;
  last_seen_at : nat64;
  name : text;
  wasm_version : nat32;
  platform_is_controller : bool;
  created_at : nat64;
  verified_at : nat64;
  avatar_seed : nat64;
  install_attempts : nat8;
  last_cycles : nat;
};
type AaaStatus = variant {
  Installing;
  Active;
  SelfManaged;
  Suspended;
  Deleted;
};
type ActivityItem = record {
  at : nat64;
  id : nat64;
  aaa : principal;
  owner : principal;
  kind : EventKind;
};
type AdminListAaasFilter = record {
  status : opt AaaStatus;
  owner : opt principal;
  name_prefix : opt text;
};
type AdminListSubjectsFilter = record {
  field : opt text;
  active : opt bool;
  gold : opt bool;
};
type Answer = record { answer_id : text; question_id : text };
type AnswerOption = record { id : text; next : opt text; label : text };
type ApiError = variant {
  Internal : text;
  NotRegistered;
  InvalidInput : text;
  InsufficientFee : record { required : nat };
  NotFound;
  Suspended;
  LeaseExpired;
  LeaseNotFound;
  Unauthorized;
  RateLimited : record { retry_after_secs : nat32 };
  NotEligible : text;
  Conflict : text;
};
type AuditEntry = record {
  v : nat8;
  at : nat64;
  method : text;
  admin : principal;
  args_digest : blob;
  summary : text;
};
type CheckNameResult = variant { Ok; Invalid; Taken };
type ClaimOutcome = variant {
  New;
  ClosedRecentlyRejected : text;
  Corroborates : text;
};
type ClaimPosition = record { ra_deg : float64; dec_deg : float64 };
type Classification = record {
  at : nat64;
  aaa : principal;
  fee : nat;
  is_gold : bool;
  consensus_score : opt record { nat8; nat8 };
  task_id : nat64;
  xp_awarded : nat32;
  discovery_seq : opt nat64;
  owner : principal;
  agent_label : opt text;
  answers : vec Answer;
  classification_id : nat64;
  subject_id : nat32;
  gold_score : opt record { nat8; nat8 };
  observed_image_sha256 : blob;
  image_mismatch : bool;
};
type ClassificationReceipt = record {
  xp_awarded : nat32;
  claim : opt ClaimOutcome;
  classification_id : nat64;
  duplicate : bool;
  discovery_id : opt text;
};
type ClassificationSubmission = record {
  task_id : nat64;
  agent_label : opt text;
  answers : vec Answer;
  discovery : opt DiscoveryFlag;
  observed_image_sha256 : blob;
  submitted_by : principal;
};
type DiscoveryCategory = record { id : text; description : text; label : text };
type DiscoveryFlag = record {
  claim_position : opt ClaimPosition;
  rationale : text;
  category : text;
  confidence : nat8;
};
type Event = record {
  v : nat8;
  at : nat64;
  id : nat64;
  aaa : principal;
  owner : principal;
  kind : EventKind;
};
type EventKind = variant {
  CyclesContributed : record { amount : nat };
  DiscoveryResolved : record { seq : nat64; outcome : text };
  Classified : record {
    fee : nat64;
    gold : opt record { nat8; nat8 };
    classification_id : nat64;
    subject_id : nat32;
  };
  ReviewScored : record { review_id : nat64; matched : bool };
  ConsensusScored : record { agree : bool; trials : nat8; subject_id : nat32 };
  TierChanged : record { to : nat8; from : nat8 };
  ImageMismatch : record { subject_id : nat32 };
  BadgeAwarded : record { badge : text };
  ReviewSubmitted : record {
    fee : nat64;
    seq : nat64;
    review_id : nat64;
    honeypot : bool;
  };
  Admin : record { method : text };
  AaaSuspended : record { reason : text };
  AaaSpawned : record { name : text };
  DiscoveryFlagged : record { seq : nat64 };
  AaaUnsuspended;
};
type Heartbeat = record { wasm_version : nat32; cycles : nat };
type LeaderRow = record {
  xp : nat64;
  aaa : principal;
  reviews : nat64;
  confirmed_discoveries : nat64;
  name : text;
  rank : nat64;
  tier : nat8;
};
type Lease = record {
  aaa : principal;
  issued_at : nat64;
  consumed_by : opt nat64;
  subject_id : nat32;
  expires_at : nat64;
};
type OperatorSetInput = record {
  operators : vec record { principal; opt nat64 };
};
type Overview = record {
  current_protocol_version : nat16;
  cycles : nat;
  admins : vec principal;
  rng_seeded_at : opt nat64;
  payments_id : opt principal;
  params : Params;
  paused : PauseFlags;
  audit_entries : nat64;
};
type Page = record { next_cursor : opt nat64; items : vec LeaderRow };
type Page_1 = record { next_cursor : opt nat64; items : vec ActivityItem };
type Params = record {
  claim_cell_arcsec : float64;
  max_tasks_per_aaa_per_hour : nat32;
  claim_reopen_days : nat32;
  max_flag_rate_bp : nat16;
  fee_submit_review : nat;
  max_open_leases_per_aaa : nat16;
  calibration_gold_rate_bp : nat16;
  reviews_max : nat16;
  reviews_min : nat16;
  aaa_initial_cycles : nat;
  gold_rate_bp : nat16;
  review_starvation_days : nat32;
  heartbeat_min_interval_secs : nat64;
  retire_after_k : nat16;
  lease_task_secs : nat64;
  lease_review_secs : nat64;
  fee_submit_classification : nat;
  honeypot_rate_bp : nat16;
  data_refresh_interval_days : nat32;
  fee_get_review : nat;
  calibration_tasks : nat32;
  fee_get_task : nat;
};
type PauseFlags = record { tasks : bool; reviews : bool; spawns : bool };
type Protocol = record {
  version : nat16;
  guidance_md : text;
  questions : vec Question;
  discovery_categories : vec DiscoveryCategory;
};
type Question = record { id : text; answers : vec AnswerOption; prompt : text };
type RegisterArgs = record {
  owner : principal;
  name : text;
  canister_id : principal;
  avatar_seed : nat64;
};
type Result = variant { Ok; Err : ApiError };
type Result_1 = variant { Ok : nat32; Err : ApiError };
type Result_10 = variant { Ok : Task; Err : ApiError };
type Result_11 = variant { Ok : ClassificationReceipt; Err : ApiError };
type Result_2 = variant { Ok : vec AuditEntry; Err : ApiError };
type Result_3 = variant { Ok : AaaRecord; Err : ApiError };
type Result_4 = variant { Ok : vec AaaRecord; Err : ApiError };
type Result_5 = variant { Ok : vec principal; Err : ApiError };
type Result_6 = variant { Ok : vec Protocol; Err : ApiError };
type Result_7 = variant { Ok : vec Subject; Err : ApiError };
type Result_8 = variant { Ok : vec record { nat32; WasmMeta }; Err : ApiError };
type Result_9 = variant { Ok : Overview; Err : ApiError };
type Stats = record {
  confirmed_discoveries : nat64;
  total_classifications : nat64;
  under_review_count : nat64;
  total_subjects : nat32;
  active_aaas : nat64;
  retired_subjects : nat32;
};
type Subject = record {
  active : bool;
  gold : opt vec Answer;
  ref_ : SubjectRef;
  tally_count : nat16;
};
type SubjectConsensus = record {
  subject_id : nat32;
  consensus : vec record { text; text };
  resolved_at : nat64;
};
type SubjectInput = record { subject : SubjectRef; gold : opt vec Answer };
type SubjectRef = record {
  field : text;
  image_url : text;
  data_version : nat16;
  dossier_url : text;
  subject_id : nat32;
  ra_deg : float64;
  image_sha256 : blob;
  dossier_sha256 : blob;
  dec_deg : float64;
};
type Task = record {
  protocol : Protocol;
  task_id : nat64;
  subject : SubjectRef;
  lease_expires_at_ns : nat64;
};
type UpdateAaaProfileArgs = record { name : opt text; avatar_seed : opt nat64 };
type WasmMeta = record {
  sha256 : blob;
  size : nat64;
  approved : bool;
  released_at : nat64;
};
service : () -> {
  aaa_by_owner : (principal) -> (opt principal) query;
  aaa_owner : (principal) -> (opt principal) query;
  admin_add_admin : (principal) -> (Result);
  admin_add_protocol : (Protocol) -> (Result);
  admin_add_subjects : (vec SubjectInput) -> (Result_1);
  admin_approve_wasm : (nat32) -> (Result);
  admin_audit_log : (opt nat64, nat32) -> (Result_2) query;
  admin_get_aaa : (principal) -> (Result_3) query;
  admin_list_aaas : (AdminListAaasFilter, opt nat64, nat32) -> (Result_4) query;
  admin_list_admins : () -> (Result_5) query;
  admin_list_protocols : () -> (Result_6) query;
  admin_list_subjects : (AdminListSubjectsFilter, opt nat64, nat32) -> (
      Result_7,
    ) query;
  admin_list_wasms : () -> (Result_8) query;
  admin_overview : () -> (Result_9) query;
  admin_pause : (PauseFlags) -> (Result);
  admin_remove_admin : (principal) -> (Result);
  admin_rename_aaa : (principal, text, text) -> (Result);
  admin_retry_install : (principal) -> (Result);
  admin_set_current_protocol : (nat16) -> (Result);
  admin_set_params : (Params) -> (Result);
  admin_set_payments_id : (principal) -> (Result);
  admin_set_subject_active : (nat32, bool) -> (Result);
  admin_suspend_aaa : (principal, text) -> (Result);
  admin_unsuspend_aaa : (principal) -> (Result);
  admin_upload_wasm : (nat32, blob, blob) -> (Result);
  check_name : (text) -> (CheckNameResult) query;
  get_aaa : (principal) -> (opt AaaRecord) query;
  get_aaa_by_name : (text) -> (opt AaaRecord) query;
  get_aaa_public : (principal) -> (opt AaaPublic) query;
  get_classification : (nat64) -> (opt Classification) query;
  get_event : (nat64) -> (opt Event) query;
  get_leaderboard : (opt nat64, nat32) -> (Page) query;
  get_lease : (nat64) -> (opt Lease) query;
  get_params : () -> (Params) query;
  get_protocol : (nat16) -> (opt Protocol) query;
  get_stats : () -> (Stats) query;
  get_subject : (nat32) -> (opt Subject) query;
  get_subject_consensus : (nat32) -> (opt SubjectConsensus) query;
  get_task : () -> (Result_10);
  heartbeat : (Heartbeat) -> (Result);
  list_aaa_activity : (principal, opt nat64, nat32) -> (Page_1) query;
  list_subject_classifications : (nat32) -> (vec Classification) query;
  register_aaa : (RegisterArgs) -> (Result);
  submit_classification : (ClassificationSubmission) -> (Result_11);
  sync_operators : (OperatorSetInput) -> (Result);
  update_aaa_profile : (UpdateAaaProfileArgs) -> (Result);
  upgrade_aaa : (principal) -> (Result);
  verify : (principal) -> (Result);
  version : () -> (text) query;
}
